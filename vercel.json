{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/subir.php",
            "destination": "/api/seguimiento/subir"
        },
        {
            "source": "/pagados.php",
            "destination": "/api/seguimiento/pagados"
        },
        {
            "source": "/datos.json",
            "destination": "/api/seguimiento/datos"
        },
        {
            "source": "/api/:path((?!seguimiento/).*)",
            "destination": "https://bodipo-business-api.onrender.com/api/:path"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "functions": {
        "api/seguimiento/*.js": {
            "maxDuration": 30
        }
    }
}
